# Copy to .env (ignored by git). Leave all four empty to run without Huly.
HULY_URL=https://huly.example.com
HULY_WORKSPACE=example
HULY_EMAIL=john.doe@example.com
HULY_PASSWORD=change-me

# GitHub Issues (plugins/github/README.md): a fine-grained token with Issues: Read and write.
# GITHUB_TOKEN=github_pat_change-me

# Folder with one Claude config folder per extra account; defaults to ~/.claude-accounts.
# EVEN_KEEL_ACCOUNTS_DIR=C:\Users\john.doe\.claude-accounts

# Tally session statistics: the service collects them itself every 5 minutes into a local PGlite database
# (state/tally). Set these only for an own Postgres server (tally/deploy): the collector writes, the page only reads.
# TALLY_DB_HOST=100.64.0.1
# TALLY_DB_PORT=5432
# TALLY_DB_NAME=tally
# TALLY_WRITER_PASSWORD=change-me-writer
# TALLY_READER_PASSWORD=change-me-reader
# Tally's span classifier: LiteLLM on the server (OpenAI-compatible); no key — the classifier is skipped.
# TALLY_LLM_URL=http://100.64.0.1:4000
# TALLY_LLM_KEY=sk-change-me
# TALLY_LLM_MODEL=google-gemini-3.1-flash-lite
