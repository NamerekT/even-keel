# Copy to .env (ignored by git). Leave all four empty to run without Huly.
HULY_URL=https://huly.example.com
HULY_WORKSPACE=example
HULY_EMAIL=john.doe@example.com
HULY_PASSWORD=change-me

# Folder with one Claude config folder per extra account; defaults to %USERPROFILE%\.claude-accounts.
# BATON_ACCOUNTS_DIR=C:\Users\john.doe\.claude-accounts

