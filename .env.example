# Copy to .env (ignored by git).
# The trackers' credentials are profiles: /settings -> Access -> Add profile. Tracker variables found here
# on the first start become the default profile of their tracker, once; after that they are not read.
# HULY_URL=https://huly.example.com
# HULY_WORKSPACE=example
# HULY_EMAIL=john.doe@example.com
# HULY_PASSWORD=change-me
# GITHUB_TOKEN=github_pat_change-me
# LINEAR_TOKEN=lin_api_change-me

# The CIs' tokens are profiles too (docs/ci.md): GitHub Actions takes a GitHub profile's, Forgejo a Forgejo profile's.
# A FORGEJO_TOKEN found here on the first start becomes a Forgejo profile per host of the projects' Forgejo remotes, once.
# FORGEJO_TOKEN=change-me

# Where the page listens; defaults to 127.0.0.1 and 4747. Read at startup.
# EVEN_KEEL_HOST=127.0.0.1
# EVEN_KEEL_PORT=4747

# The local MCP gateway chain sessions reach their packages' servers through (docs/packages.md); always on 127.0.0.1.
# EVEN_KEEL_MCP_PORT=4748

# The page's token for requests from other machines; required when EVEN_KEEL_HOST is not loopback (README).
# EVEN_KEEL_TOKEN=change-me-0123456789abcdef

# Folder with one Claude config folder per extra account; defaults to ~/.claude-accounts.
# EVEN_KEEL_ACCOUNTS_DIR=C:\Users\john.doe\.claude-accounts

# Folder with one CODEX_HOME per Codex account added from the page; defaults to ~/.codex-accounts.
# EVEN_KEEL_CODEX_ACCOUNTS_DIR=C:\Users\john.doe\.codex-accounts

# Folder with one folder per OpenCode account added from the page; defaults to ~/.opencode-accounts.
# EVEN_KEEL_OPENCODE_ACCOUNTS_DIR=C:\Users\john.doe\.opencode-accounts

# Path to the opencode binary; defaults to the native one of the global npm package on Windows, opencode elsewhere.
# EVEN_KEEL_OPENCODE_BIN=C:\tools\opencode\opencode.exe

# Tally session statistics: the service collects them itself every 5 minutes into a local PGlite database
# (state/tally). Set these only for an own Postgres server (tally/deploy): the collector writes, the page only reads.
# TALLY_DB_HOST=100.64.0.1
# TALLY_DB_PORT=5432
# TALLY_DB_NAME=tally
# TALLY_WRITER_PASSWORD=change-me-writer
# TALLY_READER_PASSWORD=change-me-reader
# Tally's span classifier: LiteLLM on the server (OpenAI-compatible); no key — the classifier is skipped.
# TALLY_LLM_URL=http://100.64.0.1:4000
# TALLY_LLM_KEY=sk-change-me
# TALLY_LLM_MODEL=google-gemini-3.1-flash-lite
