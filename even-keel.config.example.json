{
  "host": "0.0.0.0",
  "port": 4747,
  "tracker": "huly",
  "parallel": 1,
  "chain": {
    "active": ["Todo", "In Progress", "In Review"],
    "terminal": ["Done", "Canceled"],
    "requiredLabels": [],
    "excludedLabels": ["Manual"]
  },
  "projects": {
    "ABC": "C:\\repos\\example-project",
    "XYZ": {
      "repo": "C:\\repos\\other-project",
      "slot": true,
      "brief": false,
      "chain": { "requiredLabels": ["Auto"] },
      "prompt": "Run npm test before merging.",
      "commands": { "beforeStart": ["npm ci"] }
    },
    "GHB": {
      "repo": "C:\\repos\\github-project",
      "tracker": "github",
      "github": "octo-org/github-project",
      "chain": {
        "active": ["Open"],
        "terminal": ["Completed", "Not planned", "Duplicate"],
        "requiredLabels": ["ready"]
      }
    }
  },
  "context": {
    "window": 400000,
    "warn": 50,
    "danger": 80
  },
  "model": "opus",
  "modelPrompts": {
    "sonnet": "You are Sonnet. Do not split the task into subtasks and do not put model labels on tasks. If the task turns out bigger than it looked, stop and write what you found; Opus or the user will split it. File question tasks and bugs found on the way as usual, without a model label."
  }
}
