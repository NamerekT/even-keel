{
  "name": "even-keel",
  "version": "0.3.0-rc.1",
  "description": "Runs Claude Code sessions over a tracker's tasks one after another, in the order of their blocks relations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NamerekT/even-keel.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "even-keel": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/tally",
    "dist/web",
    "!dist/**/*.fixture.js",
    "!dist/**/fixture.js",
    "plugins",
    "!plugins/**/*.test.mjs",
    "statusline",
    "service/*.cs",
    "service/install.*",
    "service/uninstall.*",
    "tally/bin",
    "tally/tally.config.json",
    ".claude-plugin",
    ".env.example",
    "even-keel.config.example.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:fake": "vite --config web/vite.config.ts --mode fake",
    "build": "tsc -p tsconfig.json && tsx scripts/copy-assets.ts && tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json && tsc -p tally/tsconfig.json",
    "test": "vitest run --exclude \"src/e2e/**\" --exclude \"src/e2e-cli/**\" --exclude \"src/e2e-trackers/**\"",
    "test:e2e": "vitest run src/e2e/",
    "test:cli": "vitest run src/e2e-cli/",
    "test:trackers": "vitest run src/e2e-trackers/",
    "test:all": "vitest run --exclude \"src/e2e-cli/**\" --exclude \"src/e2e-trackers/**\"",
    "tally": "tsx tally/src/main.ts",
    "shot": "tsx scripts/shot.ts",
    "storage": "tsx scripts/storage.ts",
    "break-labels": "tsx scripts/break-labels.ts",
    "cli-check": "tsx scripts/cli-check.ts",
    "cli-compare": "tsx scripts/cli-sample-compare.ts",
    "cli-fetch": "tsx scripts/cli-fetch.ts",
    "design-baseline": "tsx scripts/design-baseline.ts",
    "notice-lengths": "tsx scripts/notice-lengths.ts"
  },
  "devDependencies": {
    "@hcengineering/api-client": "0.7.423",
    "@hcengineering/core": "0.7.423",
    "@hcengineering/rank": "0.7.423",
    "@hcengineering/text-core": "0.7.423",
    "@hcengineering/text-markdown": "0.7.423",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-code": "3.32.2",
    "@tiptap/extension-code-block": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "21.0.4",
    "playwright": "^1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unified": "11.0.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "pg": "^8.23.1"
  },
  "overrides": {
    "@hcengineering/text": {
      "@tiptap/core": "3.32.2",
      "@tiptap/html": "3.32.2",
      "@tiptap/pm": "3.32.2",
      "@tiptap/starter-kit": "3.32.2",
      "@tiptap/suggestion": "3.32.2",
      "@tiptap/extension-blockquote": "3.32.2",
      "@tiptap/extension-bold": "3.32.2",
      "@tiptap/extension-bullet-list": "3.32.2",
      "@tiptap/extension-code": "3.32.2",
      "@tiptap/extension-code-block": "3.32.2",
      "@tiptap/extension-document": "3.32.2",
      "@tiptap/extension-dropcursor": "3.32.2",
      "@tiptap/extension-gapcursor": "3.32.2",
      "@tiptap/extension-hard-break": "3.32.2",
      "@tiptap/extension-heading": "3.32.2",
      "@tiptap/extension-highlight": "3.32.2",
      "@tiptap/extension-history": "3.32.2",
      "@tiptap/extension-horizontal-rule": "3.32.2",
      "@tiptap/extension-italic": "3.32.2",
      "@tiptap/extension-link": "3.32.2",
      "@tiptap/extension-list-item": "3.32.2",
      "@tiptap/extension-mention": "3.32.2",
      "@tiptap/extension-ordered-list": "3.32.2",
      "@tiptap/extension-paragraph": "3.32.2",
      "@tiptap/extension-strike": "3.32.2",
      "@tiptap/extension-subscript": "3.32.2",
      "@tiptap/extension-superscript": "3.32.2",
      "@tiptap/extension-table": "3.32.2",
      "@tiptap/extension-table-cell": "3.32.2",
      "@tiptap/extension-table-header": "3.32.2",
      "@tiptap/extension-table-row": "3.32.2",
      "@tiptap/extension-task-item": "3.32.2",
      "@tiptap/extension-task-list": "3.32.2",
      "@tiptap/extension-text": "3.32.2",
      "@tiptap/extension-text-align": "3.32.2",
      "@tiptap/extension-text-style": "3.32.2",
      "@tiptap/extension-typography": "3.32.2",
      "@tiptap/extension-underline": "3.32.2"
    }
  }
}
