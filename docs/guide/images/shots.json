{
  "frames": [
    {
      "id": "project-page",
      "route": "/p/ABC?content=en"
    },
    {
      "id": "chain-rows",
      "route": "/p/ABC?content=en",
      "crop": { "x": 24, "y": 204, "width": 800, "height": 372 }
    },
    {
      "id": "setup-agent-step",
      "route": "/setup?step=agent&copies=fresh&content=en",
      "height": 1100,
      "crop": { "x": 240, "y": 255, "width": 792, "height": 820 }
    },
    {
      "id": "home-demo-cards",
      "route": "/?projects=none&content=en",
      "crop": { "x": 240, "y": 80, "width": 792, "height": 236 }
    },
    {
      "id": "project-wizard",
      "route": "/projects/add?content=en",
      "steps": [
        { "fill": "#wizard-target=https://github.com/example/my-app.git" },
        { "wait": "1000" },
        { "click": "#wizard-profile" },
        { "click": ".select__list li:has-text(\"Built-in\")" },
        { "fill": "#wizard-project=APP" },
        { "fill": "#wizard-name=My app" },
        { "click": "h1" },
        { "wait": "1500" }
      ],
      "height": 1620,
      "crop": { "x": 240, "y": 80, "width": 792, "height": 1444 }
    },
    {
      "id": "project-creation",
      "route": "/projects/add?job=clone&content=en",
      "steps": [{ "click": "dialog[open] h2" }],
      "selector": "dialog[open]"
    },
    {
      "id": "task-card",
      "route": "/p/ABC?content=en&task=ABC-13",
      "steps": [{ "wait": ".task-card__run" }],
      "height": 1000,
      "selector": "dialog[open]"
    },
    {
      "id": "task-card-runs-on",
      "route": "/p/ABC?chain=pins&content=en&task=ABC-10",
      "steps": [{ "wait": ".task-card__run" }],
      "selector": "dialog[open] .task-card__block:has(.task-card__run)"
    },
    {
      "id": "gear-menu",
      "route": "/p/ABC?update=0.2.0&content=en",
      "steps": [{ "click": ".gear-toggle" }, { "wait": "#gear-panel" }],
      "crop": { "x": 990, "y": 0, "width": 262, "height": 350 }
    },
    {
      "id": "status-screen",
      "route": "/status?trackers=problems&content=en",
      "steps": [{ "wait": ".status-connections" }],
      "height": 940
    },
    {
      "id": "chat-window",
      "route": "/p/ABC?chain=ask&content=en",
      "steps": [{ "click": ".panel__chat--waiting" }, { "wait": "dialog[open]" }],
      "selector": "dialog[open]"
    },
    {
      "id": "accounts-panel",
      "route": "/p/ABC?account=rows&content=en",
      "steps": [{ "click": ".account-block__toggle" }, { "wait": "#account-panel" }],
      "height": 1000,
      "selector": "#account-panel",
      "crop": { "x": 0, "y": 0, "width": 640, "height": 868 }
    },
    {
      "id": "header-account-chip",
      "route": "/p/ABC?header=two&content=en",
      "steps": [{ "hover": ".account-block__toggle" }, { "wait": "800" }],
      "crop": { "x": 876, "y": 0, "width": 320, "height": 206 }
    },
    {
      "id": "ci-panel",
      "route": "/p/ABC?ci=redpush&content=en",
      "steps": [{ "click": "[class*=\"chip--ci-\"]" }, { "wait": ".ci-card" }],
      "crop": { "x": 830, "y": 70, "width": 416, "height": 704 }
    },
    {
      "id": "project-chats",
      "route": "/p/ABC?content=en#chats",
      "steps": [{ "wait": ".chat-card" }, { "click": "h1" }],
      "crop": { "x": 838, "y": 77, "width": 400, "height": 692 }
    },
    {
      "id": "chat-permission",
      "route": "/p/ABC?chats=permission&content=en#chats",
      "steps": [{ "click": ".chat-card:has-text(\"changelog\")" }, { "wait": "dialog[open]" }],
      "selector": "dialog[open]"
    },
    {
      "id": "add-machine",
      "route": "/p/ABC?addMachine=new&content=en",
      "steps": [
        { "fill": "dialog .settings__text=hub.example.ts.net" },
        { "click": "dialog button[type=submit]" },
        { "wait": "dialog .add-machine__command" }
      ],
      "height": 1000,
      "selector": "dialog[open]"
    },
    {
      "id": "machines-panel",
      "route": "/p/ABC?machines=pooled&content=en",
      "steps": [{ "click": ".machine-block" }, { "wait": ".machine-panel" }],
      "selector": ".machine-panel",
      "crop": { "x": 0, "y": 0, "width": 401, "height": 416 }
    }
  ]
}
